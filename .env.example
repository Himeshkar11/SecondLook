# Example configuration for SecondLook
# Copy this file to .env and provide values locally.
# This file is an example configuration only and must not contain secrets.

# Environment
ENVIRONMENT=development

# Backend API
API_BASE_URL=

# Database
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# AI Extraction (Task 09)
AI_PROVIDER=demo
AI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL_1=anthropic/claude-3-haiku
OPENROUTER_FALLBACK_MODEL_2=openai/gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=1

# OCR
OCR_PROVIDER=
OCR_API_KEY=
OCR_BASE_URL=
